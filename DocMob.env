# ============================================================
# ZINFURN — MOBILE VERSIYA HUJJATI
# Oxirgi yangilanish: 2026-05-02
# Maqsad: Har qanday AI yoki developer qolgan joyidan davom ettirishi uchun
# ============================================================

# LOYIHA TUZILISHI
# -----------------
# Backend:  /Zin/zinfurn        — NestJS + GraphQL + MongoDB
# Frontend: /Zin/zinfurn-next   — Next.js 14 + Apollo Client + MUI + i18next

# MOBAIL ARXITEKTURASI
# ---------------------
# Mobile aniqlash:  libs/hooks/useDeviceDetect.ts  (navigator.userAgent orqali)
# Mobile layout:    LayoutHome.tsx va LayoutBasic.tsx — ikki xil shart mavjud
# Mobile wrap:      #mobile-wrap  (SCSS: scss/mobile/)
# PC wrap:          #pc-wrap      (SCSS: scss/pc/)
# Mobile SCSS:      scss/mobile/  — main.scss + partial fayllar
# Brand color:      #cf6422  (jigarrang-to'q sariq)

# MUHIM QOIDALAR
# ---------------
# - PC kodiga TEGMA — faqat mobile if (device === 'mobile') qism
# - Har bir komponentda mobile branch alohida yoziladi
# - SCSS: scss/mobile/ papkasida, #mobile-wrap ichida
# - Cross-component aloqa: window.dispatchEvent(new CustomEvent('event-name'))
# - MUI Drawer Portal orqali renders — CSS global scope bo'lishi kerak
# - PC SCSS #pc-wrap ichida — mobilga ta'sir qilmaydi

# ============================================================
# BAJARILGAN ISHLAR — TO'LIQ RO'YXAT
# ============================================================

# ── SAVAT (CART) VA CHECKOUT TIZIMI ─────────────────────────

# [CART-1] CART TIZIMI — BAJARILDI
#   Fayllar: libs/utils/cartUtils.ts, apollo/store.ts
#   - cartVar (Apollo reactive var) — localStorage ga saqlash
#   - addToCart, removeFromCart, clearCart, getCartTotal funksiyalari
#   - Miqdor oshirish/kamaytirish, takroriy qo'shganda quantity++

# [CART-2] FLY-TO-CART ANIMATSIYA — BAJARILDI
#   Fayl: libs/utils/flyToCart.ts
#   - Rasm kichrayib savat ikoniga "uchadi" effekti
#   - PC va mobile da ishlaydi

# [CART-3] CART DRAWER (PC) — BAJARILDI
#   Fayl: libs/components/cart/CartDrawer.tsx
#   - O'ngdan chiqadigan sidebar, mahsulot ro'yxati, jami, Checkout tugmasi

# [CART-4] MOBILE CART — BAJARILDI
#   Fayl: Top.tsx, scss/mobile/main.scss
#   - Navbar da savat icon + badge (dona soni)
#   - Mobil uchun alohida cart page yoki drawer

# [CART-5] CHECKOUT SAHIFASI — BAJARILDI
#   Fayl: pages/checkout.tsx, scss/pc/checkout.scss, scss/mobile/checkout.scss
#   - 3 bosqich: Delivery → Payment → Confirmation
#   - Step 1: ism, manzil, shahar, tel, izoh
#   - Step 2: karta raqami (format: XXXX XXXX XXXX XXXX), holder, expiry, CVV
#   - Karta preview (real-time yangilanadi)
#   - Test card tugmasi (4242 4242 4242 4242 / 12/26 / 123)
#   - Step 3: buyurtma tasdiqlash, orderId, manzil, tracking havolasi
#   - BUG FIX: mobile klaviatura focus muammosi — Step1/Step2/Summary
#     funksiyalari ichida e'lon qilingan edi → har keystroke da unmount/remount
#     YECHIM: <Step1 /> → {Step1()} inline chaqirish

