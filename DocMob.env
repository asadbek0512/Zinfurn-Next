# ============================================================
# ZINFURN — MOBILE VERSIYA HUJJATI
# Oxirgi yangilanish: 2026-04-27
# Maqsad: Har qanday AI yoki developer qolgan joyidan davom ettirishi uchun
# ============================================================

# LOYIHA TUZILISHI
# -----------------
# Backend:  /Zin/zinfurn        — NestJS + GraphQL + MongoDB
# Frontend: /Zin/zinfurn-next   — Next.js 14 + Apollo Client + MUI + i18next

# MOBAIL ARXITEKTURASI
# ---------------------
# Mobile aniqlash:  libs/hooks/useDeviceDetect.ts  (navigator.userAgent orqali)
# Mobile layout:    LayoutHome.tsx va LayoutBasic.tsx — ikki xil shart mavjud
# Mobile wrap:      #mobile-wrap  (SCSS: scss/mobile/)
# PC wrap:          #pc-wrap      (SCSS: scss/pc/)
# Mobile SCSS:      scss/mobile/  — main.scss + partial fayllar
# Brand color:      #cf6422  (jigarrang-to'q sariq)

# MUHIM QOIDALAR
# ---------------
# - PC kodiga TEGMA — faqat mobile if (device === 'mobile') qism
# - Har bir komponentda mobile branch alohida yoziladi
# - SCSS: scss/mobile/ papkasida, #mobile-wrap ichida
# - Cross-component aloqa: window.dispatchEvent(new CustomEvent('event-name'))
# - MUI Drawer Portal orqali renders — CSS global scope bo'lishi kerak
# - PC SCSS #pc-wrap ichida — mobilga ta'sir qilmaydi

# ============================================================
# BAJARILGAN ISHLAR — TO'LIQ RO'YXAT
# ============================================================

