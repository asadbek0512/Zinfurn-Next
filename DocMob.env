# ============================================================
# ZINFURN — MOBILE VERSIYA HUJJATI
# Maqsad: Har qanday AI yoki developer qolgan joyidan davom ettirishi uchun
# ============================================================

# LOYIHA TUZILISHI
# -----------------
# Backend:  /Zin/zinfurn        — NestJS + GraphQL + MongoDB
# Frontend: /Zin/zinfurn-next   — Next.js 14 + Apollo Client + MUI

# MOBAIL ARXITEKTURASI
# ---------------------
# Mobile aniqlash:  libs/hooks/useDeviceDetect.ts  (navigator.userAgent orqali)
# Mobile layout:    LayoutHome.tsx va LayoutBasic.tsx — ikki xil shart mavjud
# Mobile wrap:      #mobile-wrap  (SCSS: scss/mobile/)
# PC wrap:          #pc-wrap      (SCSS: scss/pc/)
# Mobile SCSS:      scss/mobile/  — faqat 3 fayl bor (main, general, homepage)
# PC SCSS:          scss/pc/      — 29 fayl, barcha sahifalar to'liq

# ============================================================
# QILINGAN ISHLAR
# ============================================================

# (1) LOYIHA TAHLILI — BAJARILDI
#     - Backend va frontend tuzilishi o'rganildi
#     - Mobile arxitekturasi tekshirildi
#     - Barcha sahifalarning mobile holati aniqlandi

# (2) ASOSIY MOBAIL MUAMMO — BAJARILDI
#     Muammo: mobaildan kirsa hamma narsa juda kichik ko'rinardi
#     Sabab 1: pages/_document.tsx da viewport meta tagi YO'Q edi
#              (brauzer sahifani 980px da render qilib kichraytirardi)
#     Tuzatish: <meta name="viewport" content="width=device-width, initial-scale=1" /> qo'shildi
#     Sabab 2: scss/mobile/main.scss da footer uchun width: 1300px yozilgan edi
#     Tuzatish: width: 100% ga o'zgartirildi
#     Sabab 3: #mobile-wrap ga overflow-x: hidden yo'q edi
#     Tuzatish: scss/app.scss ga #mobile-wrap { overflow-x: hidden } qo'shildi

# (3) MOBILE NAVBAR DRAWER OCHILMAYDI — TUZATILDI
#     Muammo 1: scss/mobile/main.scss da transform: translateX(100%) va
#               MuiDrawer-paperAnchorRight { transform: translateX(0) } bor edi
#               → MUI Drawer o'z animatsiyasini boshqaradi, bu CSS bilan to'qnashdi → drawer ochilmasdi
#     Tuzatish: transform qatorlari o'chirildi, MUI o'zi boshqaradi
#     Muammo 2: hamburger span { background: #ffffff } — ochiq fonda ko'rinmasdi
#     Tuzatish: background: #333333 qilindi
#     Muammo 3: .mobile-navbar-main da background yo'q edi → navbar shaffof va ko'rinmaydi
#     Tuzatish: background: #ffffff, box-shadow qo'shildi
#     Muammo 4: .mobile-container da display: flex yo'q edi
#     Tuzatish: display: flex qo'shildi

# (4) MOBILE NAVBAR — BAJARILDI
#     Fayl: libs/components/Top.tsx
#     - Logo (chap), notification + til + hamburger (o'ng) — fixed top
#     - MUI Drawer (o'ngdan chiqadi, 280px)
#     - Drawer header: login bo'lsa avatar+ism, bo'lmasa login linki
#     - Nav linklar: Home, Properties, Agents, Service, Community, MyPage, CS
#     - Drawer footer: Logout tugmasi
#     - SCSS: scss/mobile/main.scss — barcha classlar tayyor edi, JSX yozildi

# ============================================================
# QOLGAN ISHLAR (NAVBAT BO'YICHA)
# ============================================================

# [1] MOBILE NAVBAR — BAJARILDI (yuqorida)

# [2] MOBILE FOOTER — BAJARILDI
#     Fayl: libs/components/Footer.tsx, scss/mobile/main.scss (#footer ichida)
#     - Qora fon (#181a20), logo, tavsif, ijtimoiy tarmoqlar
#     - 2 ustunli nav linklar (Discover + Help)
#     - Pastda: to'lov ikonlari + copyright

# [2b] MOBILE HERO SECTION — BAJARILDI
#     Fayl: libs/components/common/HeroSection.tsx
#     - Balandlik: 46vh (mobile), 100vh (PC)
#     - Yozuvlar (overline+title) yuqorida — position: absolute, top: 12%
#     - Shop Now button pastda — position: absolute, bottom: 28%
#     - O'rtada bo'sh joy (ikki absolut element orasida)
#     - Strelkalar: 1.8rem (kichik), chetlarda 0.5rem
#     - Overline: 0.7rem, Title: 1.3rem, Description: 0.72rem (qisqa matn)
#     - Navbar: blur olib tashlandi, to'liq oq background
#     - Footer: #763711 rang (PC bilan bir xil)

# [2c] CATEGORY CARDS — BAJARILDI
#     Fayl: libs/components/homepage/CategoryCard.tsx
#     Layout: chap (1 yuqori + 2 pastda yonma-yon) + o'ng (1 baland) — PCga o'xshash 3+1
#     Inline style ishlatildi (SCSS selector muammosi bo'lgani uchun)
#     Balandliklar: yuqori 110px, pastki 80px, o'ng 198px (teng)

# [2d] TREND PROPERTIES — BAJARILDI
#     Fayl: libs/components/homepage/TrendProperties.tsx
#     - To'liq inline styled mobail versiya yozildi (CSS class muammosi sabab)
#     - Swiper: slidesPerView 1.6, touchStartPreventDefault false
#     - Rasm: height 170px, object-fit contain, oq fon — to'liq ko'rinadi
#     - Import: FavoriteIcon, router, userVar, REACT_APP_API_URL qo'shildi

# [2e] FLASH SALE — BAJARILDI
#     Fayl: libs/components/homepage/PopularPropertyCard.tsx
#     - Mobail: Swiper 1.5, karta 220px, qoraytirilgan overlay
#     - Badge (Exclusive Offer + % OFF): 12px, pastroq
#     - Taymer: blur ramka, backdrop-filter, PC uslubida
#     - Mahsulot nomi pastda, 13px
#     - Fon oq (PC bilan bir xil)

# [2f] ADVERTISEMENT (Repair Services) — BAJARILDI
#     Fayl: libs/components/homepage/Advertisement.tsx
#     - Gorizontal layout: chap rasm (155x185px), o'ng matn
#     - Ramka: tepa/past/chap #e66414, borderRadius 24px 0 0 24px
#     - Ikonlar sariq (#c9a55a), sarlavha 14px, matn 10px, tugma #e66414
#     - Matn padding-left: 20px — o'ngga surilgan

# [2g] TOP PROPERTIES — BAJARILDI
#     Fayl: libs/components/homepage/TopProperties.tsx
#     - Header: "——— Our Furnitures" (jigarang chiziq + qora), "Properties Collections" — chapda
#     - Tablar: Top/Popular/Trend, active rang #cf6422 (PC bilan bir xil)
#     - Kartalar: 2 ustun × 2 qator grid, 4 ta karta, inline styled
#     - "All Furnitures →" kartalar pastida o'ng tomonda

# [2h] TOP AGENTS — BAJARILDI
#     Fayl: libs/components/homepage/TopAgents.tsx
#     - Header: "——— Top Agents" + "Our Top Agents" chapda, "All Agents →" o'ngda
#     - Swiper 2.2 — 2 agent ko'rinadi
#     - Karta 200px, rasm cover, pastda overlay (ism + tur)

# [2i] EVENTS (PromoBanners) — BAJARILDI
#     Fayl: libs/components/homepage/Events.tsx
#     - 2 ta karta vertikal, har biri 110px, inline styled
#     - Button rangi: #cf6422 (jigarrang, PC bilan bir xil)
#     - Hover: faqat ichidagi rasm scale(1.1) — karta qimirlamaydi
#     - useDeviceDetect qo'shildi, mobile/PC branch ajratildi

# [2j] COMMUNITY BOARDS — BAJARILDI
#     Fayl: libs/components/homepage/CommunityBoards.tsx, CommunityCard.tsx
#     - Header: "——— News & Blogs" jigarrang chiziq + "Our Latest News" chapda, "View All →" o'ngda
#     - Tablar: News/Free, active rang #cf6422
#     - News tab: Swiper slidesPerView 1.8 — kartalar yonga svayperlaydi
#     - Free tab: vertikal list, gorizontal kartalar (rasm 60x60 chap, matn o'ng)
#     - Vertikal karta: rasm 130px, date badge pastda markazda #cf6422, sarlavha 11px, tavsif 9px
#     - Gorizontal karta: minWidth:0 + overflow:hidden — yozuvlar chiqib ketmaydi

# [3] HOMEPAGE — /pages/index.tsx
#     Holat: SCSS bor, lekin komponentlar PC bilan bir xil
#     Kerak: har bir komponentda mobile UI tekshirib, kerak bo'lsa alohida ko'rinish

# [4] PROPERTY LIST — /pages/property/index.tsx
#     Holat: return <h1>PROPERTIES MOBILE</h1>
#     Kerak: to'liq mobile UI — filter, karta ro'yxati

# [5] PROPERTY DETAIL — /pages/property/detail.tsx
#     Holat: return <div>PROPERTY DETAIL PAGE</div>
#     Kerak: rasm slider, narx, tavsif, like tugmasi

# [6] AGENT LIST — /pages/agent/index.tsx
#     Holat: return <h1>agents_page_mobile</h1>
#     Kerak: agent kartochkalari ro'yxati

# [7] AGENT DETAIL — /pages/agent/detail.tsx
#     Holat: return <div>AGENT DETAIL PAGE MOBILE</div>
#     Kerak: agent profili, uning e'lonlari

# [8] MYPAGE — /pages/mypage/index.tsx
#     Holat: return <div>MY PAGE</div>
#     Kerak: profil, mening e'lonlarim, saqlangan

# [9] COMMUNITY — /pages/community/index.tsx
#     Holat: return <h1>COMMUNITY PAGE MOBILE</h1>
#     Kerak: maqolalar ro'yxati, kategoriya filter

# [10] COMMUNITY DETAIL — /pages/community/detail.tsx
#      Holat: return <div>COMMUNITY DETAIL PAGE MOBILE</div>
#      Kerak: maqola matni, izohlar

# [11] CS — /pages/cs/index.tsx
#      Holat: return <h1>CS PAGE MOBILE</h1>
#      Kerak: FAQ, xabar yuborish formasi

# [12] MEMBER — /pages/member/index.tsx
#      Holat: return <>MEMBER PAGE MOBILE</>
#      Kerak: foydalanuvchi profili, e'lonlari

# [13] ABOUT — /pages/about/index.tsx
#      Holat: return <div>ABOUT PAGE MOBILE</div>
#      Kerak: kompaniya haqida ma'lumot

# [14] ACCOUNT/JOIN — /pages/account/join.tsx
#      Holat: return <div>LOGIN MOBILE</div>
#      Kerak: login va ro'yxatdan o'tish formasi

# [15] REPAIR SERVICE — /pages/repairService/index.tsx
#      Holat: mobile tekshiruvi yo'q, PC ko'rsatiladi
#      Kerak: useDeviceDetect qo'shib mobile UI yozish

